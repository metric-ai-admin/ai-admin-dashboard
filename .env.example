# Asana Personal Access Token (do NOT commit this file). Reuses the same
# Asana V2 token already configured for metric-dashboard.
ASANA_TOKEN=

# Asana project GIDs to pull AI Admin tasks from (comma-separated "gid:Label").
ASANA_EXTRA_PROJECTS=

# Server port. Must differ from metric-dashboard's port (3000) so both can
# run at the same time.
PORT=3001

# The service's own public URL — required in production (e.g. Render) so
# the Microsoft OAuth redirect doesn't point at an unreachable localhost
# URL. Leave blank for local dev (defaults to http://localhost:$PORT).
# That same URL + /auth/callback must also be registered as a redirect URI
# in the Azure App Registration.
APP_BASE_URL=

# Overrides where data/*.json (tasks, Lyndsay queue, Graph token cache, etc.)
# is stored. Leave blank for local dev (defaults to ./data). In production
# this MUST point at a persistent disk mount — Render's filesystem is
# otherwise ephemeral and wipes all runtime data on every deploy/restart.
DATA_DIR=

# ---- Microsoft Graph API (Email + Calendar, both mailboxes) ----
# Fill these in once the Azure App Registration is created. Leave blank to
# keep the Email/Calendar module in stub mode. Uses delegated permissions
# (Mail.Read, Mail.Read.Shared, Calendars.Read, Calendars.Read.Shared) —
# once set, open /auth/login on the dashboard for a one-time browser sign-in
# as Arturo. The App Registration needs a Web redirect URI of
# http://localhost:3001/auth/callback.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Mailbox addresses.
MAILBOX_ARTURO=support@livewithmetric.com
MAILBOX_LYNDSAY=lyndsay@metricpropertymanagement.com

# All Metric departmental mailboxes for the Inbox Tracking report (application
# permissions via graphMailToken() cover every mailbox in the tenant — no
# per-mailbox delegate access needed). Comma-separated addresses.
METRIC_MAILBOXES=support@livewithmetric.com,collections@livewithmetric.com,hello@livewithmetric.com,maintenance@livewithmetric.com,leasing@livewithmetric.com,accounting@metricpropertymanagement.com,marketing@metricpropertymanagement.com,admin@metricpropertymanagement.com,lyndsay@metricpropertymanagement.com

# Complete Inbox Tracking Excel row mapping — every row the dashboard keeps
# in sync (mailbox-level "Inbox" rows + personal per-person folder rows).
# Confirmed by Jay on 2026-08-19. Edit this JSON (not server.js) to add,
# remove, or correct a row. rowLabel must exactly match (case/whitespace
# insensitive) the label in column A of the "Inbox Tracking" sheet.
INBOX_TRACKING_MAPPING=[{"rowLabel":"Marketing Main inbox","email":"marketing@metricpropertymanagement.com","folderName":"Inbox"},{"rowLabel":"Katrina Marie Lopez","email":"marketing@metricpropertymanagement.com","folderName":"Katrina"},{"rowLabel":"Support Email inbox","email":"support@livewithmetric.com","folderName":"Inbox"},{"rowLabel":"Arturo Mendoza","email":"support@livewithmetric.com","folderName":"Arturo"},{"rowLabel":"Catherine Mae Banico","email":"support@livewithmetric.com","folderName":"Katie"},{"rowLabel":"Maintenance Main Inbox","email":"maintenance@livewithmetric.com","folderName":"Inbox"},{"rowLabel":"Erick Frey","email":"maintenance@livewithmetric.com","folderName":"Erick"},{"rowLabel":"Collections Main Inbox","email":"collections@livewithmetric.com","folderName":"Inbox"},{"rowLabel":"Karla Gonzalez","email":"collections@livewithmetric.com","folderName":"Karla"},{"rowLabel":"Rocio Hunsberger - Collections","email":"collections@livewithmetric.com","folderName":"Rocio H"},{"rowLabel":"Leasing inbox","email":"leasing@livewithmetric.com","folderName":"Inbox"},{"rowLabel":"Roxanne","email":"leasing@livewithmetric.com","folderName":"Rhoxie"},{"rowLabel":"Hello Email Inbox","email":"hello@livewithmetric.com","folderName":"Inbox"},{"rowLabel":"Oscar Moreno","email":"hello@livewithmetric.com","folderName":"Oscar"},{"rowLabel":"Danny Arias","email":"hello@livewithmetric.com","folderName":"Danny - Receptionist Coordinator"},{"rowLabel":"Accounting Email Inbox","email":"accounting@metricpropertymanagement.com","folderName":"Inbox"},{"rowLabel":"Claudia Villalobos","email":"accounting@metricpropertymanagement.com","folderName":"Claudia"},{"rowLabel":"Jay Admin Email","email":"admin@metricpropertymanagement.com","folderName":"Inbox"},{"rowLabel":"Rocio Hunsberger - Hello","email":"hello@livewithmetric.com","folderName":"Rocio"},{"rowLabel":"Yeni Aleman","email":"hello@livewithmetric.com","folderPath":["Inbox","Rocio","Oscar","Yeni"]},{"rowLabel":"Sammy Ramos","email":"hello@liveatwindyhill.com","folderName":"Inbox"}]

# How often (minutes) the background email/calendar refresh job runs.
EMAIL_REFRESH_MINUTES=15

# How far ahead of a meeting on Lyndsay's calendar to auto-generate a
# reminder message in the Lyndsay Message Queue (copy/paste only).
# Lead time varies by meeting type — see classifyMeeting() in server.js.
REMINDER_MINUTES_CLIENT=4
REMINDER_MINUTES_INTERNAL=4
REMINDER_MINUTES_LEGAL=5
REMINDER_MINUTES_DEFAULT=4

# Timezones for dual-time display on meeting cards/reminders.
# ARTURO_TIMEZONE: UTC-4, no DST. LYNDSAY_TIMEZONE: US Central, observes DST.
ARTURO_TIMEZONE=America/Caracas
LYNDSAY_TIMEZONE=America/Chicago

# Erick's personal Asana token (optional). ASANA_TOKEN above belongs to
# support@livewithmetric.com and only ever sees Arturo's tasks, so the
# Maintenance > Asana Tasks view requests ?owner=erick and the server switches
# to this token. Leave blank and that view explains it needs connecting.
ASANA_TOKEN_ERICK=

# Which Asana workspace to query. Both accounts belong to a personal
# "livewithmetric.com" workspace as well as the org, and the personal one is
# empty — picking it is why every Asana pull once returned nothing. Accepts a
# name or a gid. Defaults to "Metric Property Management".
ASANA_WORKSPACE=

# NOTE: ASANA_EXTRA_PROJECTS above is parsed and available but no longer feeds
# Arturo's board — that now comes from his Asana "My Tasks" list, so it holds his
# own work rather than every task on those project boards. Whichever account
# ASANA_TOKEN belongs to is the one whose My Tasks is shown; if the board looks
# empty, that token is probably not the account the work is assigned to.

# ---- Maintenance module (Erick) ----
# Shared secret guarding /api/appfolio/* — those routes expose billable dollar
# amounts and per-technician labour hours, and server.js has no global auth gate.
# The dashboard UI authenticates with its session cookie; MCP clients send this
# value as the x-metric-key header, so it must match on both sides.
# Generate with: openssl rand -hex 32
# If left blank the module logs a warning at startup and stays publicly readable.
METRIC_API_KEY=

# ---- AppFolio Reports API v2 (read-only) ----
# From AppFolio → Settings → API. Nothing here writes back to AppFolio.
# All three are required; with any missing, the Reports Sync, Maintenance
# Efficiency and Technician Activity views report "not configured".
# Rate limit is 7 requests / 15 seconds, enforced client-side.
APPFOLIO_CLIENT_ID=
APPFOLIO_CLIENT_SECRET=
APPFOLIO_SUBDOMAIN=

# ---- BD CRM — Supabase (metric-bd-crm project) ----
# Project URL from Supabase dashboard → Settings → API.
SUPABASE_URL=
# Anon/public key — safe for server-side reads. Use service role key for
# writes/admin operations (Settings → API → service_role). NEVER commit either.
SUPABASE_ANON_KEY=
# Service role key — full database access, bypasses RLS. Required for the
# bulk-import migration script and any server-side writes.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to protect the BD CRM API endpoints from the public internet.
# Set any strong random string (e.g. openssl rand -hex 32).
CRM_API_SECRET=
